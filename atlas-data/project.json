 "manuscript_root": "/Users/business/Documents/Founded/Obsidian/The Founded Project Manuscript",
 "thesis": "Human flourishing emerges through the governance of competing forces within moral boundaries.",
 "thesis_source": "Founded Glossary v1.0, restating Founded Canon v1.0 Core Thesis with the Canon Addendum v1.1 moral boundary",
 "canon_core_thesis": [
  "Human flourishing emerges through the governance of competing forces.",
  "Healthy systems are rarely built through absolutes.",
  "They emerge through the ongoing balance of tensions that must coexist.",
  "Freedom and responsibility.",
  "Identity and openness.",
  "Competition and cooperation.",
  "Innovation and stability.",
  "Individual and community.",
  "Security and adaptability.",
  "The pursuit of any single force to its extreme eventually destabilizes the larger system.",
  "Human flourishing requires balance.",
  "Balance requires governance.",
  "Governance creates agency.",
  "Agency enables contribution."
 ],
 "canon_definition_of_agency": [
  "Agency is the capacity to make intentional choices that influence one's life, relationships, environment, and future.",
  "Agency requires:",
  "- awareness",
  "- capacity",
  "- choice",
  "- responsibility",
  "- action",
  "Agency is not unlimited control.",
  "Agency exists within reality.",
  "The goal is not control over everything.",
  "The goal is meaningful influence over what can be influenced.",
  "Agency is the central organizing concept of The Founded Project."
 ],
